{
  "name": "@nictech/erp",
  "private": true,
  "version": "0.1.2",
  "description": "Sistema de gestión NicTech ERP",
  "author": "NicTech",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port 8081",
    "build": "vite build",
    "preview": "vite preview --port 8081",
    "typecheck": "tsc --noEmit",
    "test:desktop": "node --test tests/electron-window.node.cjs",
    "electron:dev": "node electron/dev.cjs",
    "electron:start": "electron .",
    "electron:preview": "npm run build && electron .",
    "electron:dist": "npm run typecheck && npm run build && electron-builder --publish never"
  },
  "build": {
    "electronVersion": "44.4.5",
    "appId": "ar.com.nictech.erp",
    "productName": "NicTech ERP",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "public/Manual_Operativo_ERP_NicTech.pdf",
        "to": "Manual_Operativo_ERP_NicTech.pdf"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "public/brand/nictech.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "installerIcon": "public/brand/nictech.ico",
      "uninstallerIcon": "public/brand/nictech.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "NicTech ERP"
    }
  },
  "dependencies": {
    "@fontsource-variable/source-sans-3": "^5.2.8",
    "@nictech/domain": "*",
    "@supabase/supabase-js": "^2.89.0",
    "@tanstack/react-query": "^5.83.0",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.61.1",
    "recharts": "^2.15.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "electron": "44.4.5",
    "electron-builder": "^26.15.3",
    "typescript": "^5.8.3",
    "vite": "^7.3.6"
  }
}
